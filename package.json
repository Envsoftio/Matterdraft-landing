{
  "name": "matterdraft-landing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MatterDraft Studio — fast, accessible Nuxt and Tailwind landing page",
  "engines": { "node": "^22.22.3 || ^24.15.0 || >=26.0.0" },
  "scripts": {
    "predev": "npm run content",
    "dev": "nuxt dev --host 0.0.0.0",
    "content": "node scripts/generate-content.mjs",
    "build": "npm run content && nuxt build",
    "generate": "npm run content && NITRO_PRESET=static nuxt generate && node scripts/export-static.mjs",
    "preview": "node scripts/serve-static.mjs",
    "preview:ssr": "node .output/server/index.mjs",
    "typecheck": "nuxt typecheck",
    "test": "node --test tests/*.test.mjs",
    "verify": "node scripts/verify-build.mjs",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "nuxt": "4.6.3",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "marked": "18.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vue-tsc": "3.3.14"
  }
}
