NUXT_PUBLIC_SITE_URL=https://matterdraft.legal
TURSO_DATABASE_URL=libsql://matterdraft-vishnuchd.aws-eu-west-1.turso.io
# Set this privately in .env or in the hosting environment.
TURSO_AUTH_TOKEN=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
# The desktop app must register this exact private-use callback scheme.
DESKTOP_REDIRECT_URI=legal.matterdraft.studio:/oauth/callback
# Set both privately to send account email from the server via ZeptoMail SMTP.
# Local development writes to .data/mail-preview/ when both are unset.
ZEPTOMAIL_SMTP_PASSWORD=
ZEPTOMAIL_FROM=
# For a private preview build only, add NUXT_PUBLIC_INDEXABLE=false.
# Google Apps Script web app endpoint and shared secret. Keep these server-side.
EARLY_ACCESS_GOOGLE_SHEETS_URL=https://script.google.com/macros/s/AKfycbxgupoEezY2x0mQzQ_h3LkyctyQFpWQ-fxs-1mz1-pA3DChLIEjnuG5Lf1Yz7DsUQhtSQ/exec
EARLY_ACCESS_GOOGLE_SHEETS_SECRET=

# Optional private desktop distribution. Leave unset until a release is approved.
# See docs/portal-setup.md for the manifest shape and S3 permissions.
DESKTOP_INSTALLERS=
DESKTOP_DOWNLOAD_S3_BUCKET=
DESKTOP_DOWNLOAD_S3_REGION=
DESKTOP_DOWNLOAD_S3_ACCESS_KEY_ID=
DESKTOP_DOWNLOAD_S3_SECRET_ACCESS_KEY=
DESKTOP_DOWNLOAD_S3_SESSION_TOKEN=

# Optional Razorpay test checkout. Use the test dashboard and register
# /api/webhooks/razorpay for payment_link.paid. Keep the secrets server-side.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
